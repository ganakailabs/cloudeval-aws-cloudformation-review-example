{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Secondary JSON CloudFormation template for Cloudeval AWS review coverage.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "review"
    }
  },
  "Resources": {
    "AuditLogBucket": {
      "Type": "AWS::S3::Bucket",
      "Metadata": {
        "checkov": {
          "skip": [
            {
              "id": "CKV_AWS_18",
              "comment": "Dedicated audit-log destination bucket for this review fixture."
            }
          ]
        }
      },
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": false,
          "BlockPublicPolicy": false,
          "IgnorePublicAcls": false,
          "RestrictPublicBuckets": false
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          },
          {
            "Key": "Purpose",
            "Value": "Cloudeval AWS JSON parser coverage"
          }
        ],
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      }
    },
    "AuditLogPublicReadPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditLogBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PublicReadForDemoRegression",
              "Effect": "Allow",
              "Principal": "*",
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${AuditLogBucket.Arn}/*"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "AuditLogBucketName": {
      "Value": {
        "Ref": "AuditLogBucket"
      }
    }
  }
}
